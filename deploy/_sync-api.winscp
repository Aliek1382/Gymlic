# Mirrors the PHP backend onto the host. Driven by deploy.bat:
#   %1% saved session   %2% local backend-php\   %3% remote backend root
#
# config.php is the one file that must survive a deploy: it holds the host's
# real database password, and the copy in git still says CHANGE_ME, which
# takes the API down. A name-only mask is what works here -- a mask carrying a
# path was tried twice, with and without a leading slash, and WinSCP matched
# neither.
#
# public/uploads/ holds every avatar and club logo users have uploaded, and is
# deliberately NOT masked. Locally the folder contains only .gitkeep and
# .gitignore, and sending those is what makes the folder exist on the host at
# all -- WinSCP creates a remote directory only when it has something to put in
# it, so masking them meant a deploy onto an empty host left the app with
# nowhere to write. The live files are safe regardless, because there is no
# -delete: nothing here removes anything.
#
# That absent -delete is also why a stale .php file left behind is fine:
# index.php routes every request, so nothing reaches an orphan.
option batch abort
option confirm off
open %1%
synchronize remote -criteria=either -filemask="|config.php" "%2%" "%3%"
exit
