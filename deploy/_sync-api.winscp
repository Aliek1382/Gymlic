# Mirrors the PHP backend onto the host. Driven by deploy.bat:
#   %1% saved session   %2% local backend-php\   %3% remote backend root
#
# Two things on the host must survive a deploy:
#   config.php          holds the host's real database password; the copy in
#                       git still says CHANGE_ME and would take the API down.
#   public/uploads/     every avatar and club logo users have uploaded.
#
# Nothing is ever deleted here -- there is no -delete -- so the live uploads
# are safe by construction. The masks only stop this end from pushing over
# them. Locally that folder holds nothing but .gitignore and .gitkeep, the two
# markers that keep it in git, so excluding those names keeps the whole folder
# out of the transfer.
#
# The obvious spelling, a directory mask "public/uploads/", was tried twice --
# with and without a leading slash -- and WinSCP matched neither: both runs
# uploaded the markers anyway. Name-only masks demonstrably work, since
# config.php has been correctly skipped on every run, so the masks are written
# in the form that is known to hold.
#
# The absent -delete is also why a stale .php file left behind is fine:
# index.php routes every request, so nothing reaches an orphan.
option batch abort
option confirm off
open %1%
synchronize remote -criteria=either -filemask="|config.php;*.gitignore;*.gitkeep" "%2%" "%3%"
exit
